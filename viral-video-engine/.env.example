# viral-video-engine environment. Copy to .env (gitignored) and fill in.

# --- Supabase (required) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key>
SUPABASE_SCHEMA=viral_video             # schema to use (default: public)
STORAGE_BUCKET=viral-video-assets       # public bucket for voiceovers + videos
WORKER_ID=worker-local

# --- Claude / Anthropic (text generation; required for the generate stage) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8         # default; swappable per brand via the adapter

# --- Assets: TTS voiceover + stock b-roll (required for the assets stage) ---
GOOGLE_TTS_API_KEY=<Google Cloud API key with the Cloud Text-to-Speech API enabled>
PEXELS_API_KEY=<key from pexels.com/api>

# --- Music (optional; only for `npm run sync-music`) ---
# Absolute path to a Google service-account JSON key. The service account needs the
# Drive API enabled, and each brand's music folder shared to its email.
GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service-account.json
